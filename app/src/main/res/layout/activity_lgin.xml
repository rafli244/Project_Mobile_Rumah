<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="false"
    android:importantForAutofill="noExcludeDescendants"
    android:background="@color/background_app">
    <androidx.cardview.widget.CardView
        android:id="@+id/cardLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardUseCompatPadding="true"
        app:cardBackgroundColor="@color/white">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:paddingTop="32dp"
            android:gravity="top">
            <ImageView
                android:id="@+id/ivLogoLogin"
                android:layout_width="48dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_sicomplaint_logo"
                android:contentDescription="Logo asli SiComplaint" />
            <Space
                android:layout_width="1dp"
                android:layout_height="24dp" />
            <TextView
                android:id="@+id/tvWelcomeTitle"
                style="@style/Text.SiComplaint.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Selamat Datang"
                android:textSize="24sp"
                android:gravity="center" />
            <Space
                android:layout_width="1dp"
                android:layout_height="8dp" />
            <TextView
                android:id="@+id/tvWelcomeSubtitle"
                style="@style/Text.SiComplaint.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Masuk untuk melanjutkan laporanmu"
                android:textSize="12sp"
                android:gravity="center" />
            <Space
                android:layout_width="1dp"
                android:layout_height="32dp" />
            <TextView
                android:id="@+id/editTextTextLabel"
                style="@style/Text.SiComplaint.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Username / Email"
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilUsername"
                style="@style/Widget.SiComplaint.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:hintEnabled="false">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTextText"
                    style="@style/Text.SiComplaint.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:minLines="1"
                    android:gravity="top|start"
                    android:hint="Username / Email"
                    android:padding="16dp"
                    android:inputType="text"
                    android:maxLength="150" />
            </com.google.android.material.textfield.TextInputLayout>
            <Space
                android:layout_width="1dp"
                android:layout_height="16dp" />
            <TextView
                android:id="@+id/editTextTextPasswordLabel"
                style="@style/Text.SiComplaint.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kata Sandi"
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPassword"
                app:endIconMode="password_toggle"
                style="@style/Widget.SiComplaint.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:hintEnabled="false">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTextTextPassword"
                    style="@style/Text.SiComplaint.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:minLines="1"
                    android:gravity="top|start"
                    android:hint="Kata Sandi"
                    android:padding="16dp"
                    android:inputType="textPassword"
                    android:maxLength="150" />
            </com.google.android.material.textfield.TextInputLayout>
            <Space
                android:layout_width="1dp"
                android:layout_height="16dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <CheckBox
                    android:id="@+id/checkBox"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"
                    android:text="Ingat username"
                    android:textSize="12sp"
                    android:textColor="@color/gray_text" />
                <TextView
                    android:id="@+id/tvLupaPassword"
                    style="@style/Text.SiComplaint.Caption"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"
                    android:gravity="end|center_vertical"
                    android:text="Lupa kata sandi?"
                    android:textColor="@color/primary" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogin"
                style="@style/Widget.SiComplaint.Button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Masuk" />
            <Space
                android:layout_width="1dp"
                android:layout_height="16dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/tvDaftar"
                style="@style/Widget.SiComplaint.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Daftar Akun" />
            <Space
                android:layout_width="1dp"
                android:layout_height="24dp" />
            <TextView
                android:id="@+id/tvDemo"
                style="@style/Text.SiComplaint.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Akun demo: rafli / 12345  •  admin / admin123"
                android:textSize="11sp"
                android:gravity="center" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</ScrollView>
