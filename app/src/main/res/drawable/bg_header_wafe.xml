<!--
PANDUAN SALIN XML KE PROJECT BARU
1. Vector header gelombang; dipanggil @drawable/bg_header_wafe di header_beranda.xml.
2. Salin ke res/drawable; pertahankan nama atau ubah semua referensinya.
3. pathData menentukan kurva, fillColor menentukan warna; ikutkan color/primary.
-->
<!-- MATERI-15 DRAWABLE: vector gelombang; pathData C adalah kurva Bezier kubik.
     Dipakai header_beranda.xml; nama wafe harus sama persis dengan referensi drawable. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="100dp"
    android:height="100dp"
    android:viewportWidth="100"
    android:viewportHeight="100">
    <path
        android:fillColor="@color/primary"
        android:pathData="M0,0 L100,0 L100,40 C75,70 30,10 0,45 Z" />
</vector>
