<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_app">
    <TextView
        android:id="@+id/btnBacaSemua"
        style="@style/Text.SiComplaint.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tandai semua dibaca"
        android:textSize="12sp"
        android:textColor="@color/primary"
        android:gravity="end|center_vertical"
        android:paddingHorizontal="16dp"
        android:minHeight="48dp" />
    <TextView
        android:id="@+id/tvEmpty"
        style="@style/Text.SiComplaint.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Belum ada notifikasi. Kirim laporan untuk memulai."
        android:textSize="14sp"
        android:padding="24dp"
        android:gravity="center" />
    <ListView
        android:id="@+id/listNotifikasi"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/gray_border"
        android:dividerHeight="1dp" />
</LinearLayout>
