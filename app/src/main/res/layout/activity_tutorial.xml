<?xml version="1.0" encoding="utf-8"?>
<!--
PANDUAN SALIN XML KE PROJECT BARU
1. Wadah tutorial: pasangan TutorialActivity, TutorialFragmentAdapter dan tiga halaman Fragment.
2. Dependency ViewPager2/dotsindicator harus tersedia.
3. Pasang adapter dalam Kotlin terlebih dahulu, lalu dotIndicator.attachTo(viewPager).
4. Ini satu Activity; setiap Fragment di pager mempunyai layout terpisah.
-->

<!-- MATERI-02: ConstraintLayout memakai constraint untuk menentukan posisi anak. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- MATERI-15: pager menampilkan halaman dari TutorialFragmentAdapter. -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/tutorialViewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- MATERI-15: indikator titik dihubungkan lewat attachTo setelah adapter dipasang. -->
    <com.tbuonomo.viewpagerdotsindicator.DotsIndicator
        android:id="@+id/dotIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="100dp"
        app:dotsColor="@color/gray_border"
        app:dotsCornerRadius="8dp"
        app:dotsSize="10dp"
        app:dotsSpacing="6dp"
        app:progressMode="true"
        app:selectedDotColor="@color/primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
