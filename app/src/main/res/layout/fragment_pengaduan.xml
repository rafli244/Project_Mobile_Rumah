<?xml version="1.0" encoding="utf-8"?>
<!--
PANDUAN SALIN XML KE PROJECT BARU | MATERI TABLAYOUT & VIEWPAGER2 (PERTEMUAN 10)
1. TabLayout dihubungkan ke ViewPager2 menggunakan TabLayoutMediator di Kotlin.
2. Atribut TabLayout dikustomisasi: warna teks aktif/non-aktif, warna & ketebalan indikator.
3. ViewPager2 menampung FragmentStateAdapter yang memuat LaporanTabFragment.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_app">

    <!-- Search Bar & ChipGroup Filter Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp">

        <EditText
            android:id="@+id/etFilter"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_white"
            android:drawableStart="@drawable/ic_figma_search"
            android:drawablePadding="8dp"
            android:paddingHorizontal="16dp"
            android:hint="Cari laporan di sekitarmu..."
            android:textSize="12sp"
            android:singleLine="true"
            android:inputType="text" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupFilter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:singleSelection="true">
            <com.google.android.material.chip.Chip
                android:id="@+id/chipSemua"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Semua Status" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chipDiproses"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Diproses" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chipMenunggu"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Menunggu" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chipSelesai"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Selesai" />
        </com.google.android.material.chip.ChipGroup>
    </LinearLayout>

    <!-- MATERI PERTEMUAN 10: TABLAYOUT DENGAN KUSTOMISASI ATRIBUT LENGKAP -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayoutPengaduan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@color/white"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/primary"
        app:tabIndicatorHeight="3dp"
        app:tabIndicatorFullWidth="false"
        app:tabSelectedTextColor="@color/primary"
        app:tabTextColor="@color/gray_text"
        app:tabRippleColor="#20E53935"
        app:elevation="2dp" />

    <!-- MATERI PERTEMUAN 10: VIEWPAGER2 WADAH FRAGMENT TAB BERGERAK (SWIPE) -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerPengaduan"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
