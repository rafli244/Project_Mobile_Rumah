<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <FrameLayout
            android:id="@+id/profileHeader"
            android:layout_width="match_parent"
            android:layout_height="352dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="304dp"
                android:orientation="vertical"
                android:id="@+id/profileHero"
                android:padding="48dp"
                android:background="@color/primary">
                <TextView
                    android:id="@+id/tvAvatar"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/bg_circle_white"
                    android:gravity="center"
                    android:text="RH"
                    android:textColor="@color/primary"
                    android:fontFamily="@font/poppins_semibold"
                    android:textSize="24sp" />
                <Space
                    android:layout_width="1dp"
                    android:layout_height="16dp" />
                <TextView
                    android:id="@+id/tvUsername"
                    style="@style/Text.SiComplaint.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Rafli Hanafi"
                    android:textSize="20sp"
                    android:gravity="center"
                    android:textColor="@color/white" />
                <Space
                    android:layout_width="1dp"
                    android:layout_height="8dp" />
                <TextView
                    android:id="@+id/tvEmail"
                    style="@style/Text.SiComplaint.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="rafli"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:textColor="#FFEAEA" />
            </LinearLayout>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:layout_gravity="bottom"
                android:layout_marginHorizontal="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tvTotal"
                                style="@style/Text.SiComplaint.Heading"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="20sp"
                                android:gravity="center"
                                android:textColor="@color/primary" />
                            <TextView
                                android:id="@+id/tvTotalLabel"
                                style="@style/Text.SiComplaint.Caption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Total Laporan"
                                android:textSize="10sp"
                                android:gravity="center" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tvSelesai"
                                style="@style/Text.SiComplaint.Heading"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="20sp"
                                android:gravity="center"
                                android:textColor="@color/primary" />
                            <TextView
                                android:id="@+id/tvSelesaiLabel"
                                style="@style/Text.SiComplaint.Caption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Selesai"
                                android:textSize="10sp"
                                android:gravity="center" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tvDiproses"
                                style="@style/Text.SiComplaint.Heading"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="20sp"
                                android:gravity="center"
                                android:textColor="@color/primary" />
                            <TextView
                                android:id="@+id/tvDiprosesLabel"
                                style="@style/Text.SiComplaint.Caption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Diproses"
                                android:textSize="10sp"
                                android:gravity="center" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </FrameLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <LinearLayout
                        android:id="@+id/btnEditProfil"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_figma_user"
                            android:importantForAccessibility="no"
                            android:layout_marginEnd="16dp" />
                        <TextView
                            style="@style/Text.SiComplaint.Body"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Edit Profil" />
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_figma_chevron"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/btnRiwayat"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_figma_reports"
                            android:importantForAccessibility="no"
                            android:layout_marginEnd="16dp" />
                        <TextView
                            style="@style/Text.SiComplaint.Body"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Riwayat Laporan" />
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_figma_chevron"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <Space
                android:layout_width="1dp"
                android:layout_height="24dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                style="@style/Widget.SiComplaint.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Keluar dari akun"
                app:icon="@drawable/ic_figma_logout" />
            <Space
                android:layout_width="1dp"
                android:layout_height="16dp" />
            <TextView
                android:id="@+id/tvIdentitas"
                style="@style/Text.SiComplaint.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SiComplaint • Lapor Cepat, Kota Berubah"
                android:textSize="11sp"
                android:gravity="center" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
