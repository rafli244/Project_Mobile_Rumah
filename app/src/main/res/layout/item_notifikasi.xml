<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp">
    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_figma_bell"
        android:importantForAccessibility="no"
        android:background="@drawable/bg_soft"
        android:padding="8dp"
        android:layout_marginEnd="16dp"
        app:tint="@color/primary" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/tvJudul"
            style="@style/Text.SiComplaint.Heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Laporan sedang diproses"
            android:textSize="13sp" />
        <Space
            android:layout_width="1dp"
            android:layout_height="8dp" />
        <TextView
            android:id="@+id/tvIsi"
            style="@style/Text.SiComplaint.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dinas mulai menangani laporan."
            android:textSize="12sp" />
        <Space
            android:layout_width="1dp"
            android:layout_height="8dp" />
        <TextView
            android:id="@+id/tvWaktu"
            style="@style/Text.SiComplaint.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tanggal"
            android:textSize="11sp" />
    </LinearLayout>
    <View
        android:id="@+id/dotUnread"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_dot" />
</LinearLayout>
