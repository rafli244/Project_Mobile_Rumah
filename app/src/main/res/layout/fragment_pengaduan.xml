<!--
PANDUAN SALIN XML KE PROJECT BARU
1. ChipGroup: salin grup beserta semua Chip anak dan id-nya.
2. Pasangan Kotlin PengaduanFragment: setOnCheckedStateChangeListener.
3. Untuk soal chip dasar cukup Toast; refresh aplikasi asli butuh repository/model/adapter.
4. ListView memakai PengaduanAdapter dan item_pengaduan.xml.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/background_app">
    <RadioGroup
        android:id="@+id/rgScope"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:padding="4dp"
        android:background="@drawable/bg_soft"
        android:checkedButton="@id/rbMilikSaya">
        <RadioButton
            android:id="@+id/rbMilikSaya"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:button="@null"
            android:background="@drawable/bg_scope"
            android:gravity="center"
            android:text="Laporan Saya"
            android:textSize="12sp"
            android:textColor="@color/primary" />
        <RadioButton
            android:id="@+id/rbMasyarakat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:button="@null"
            android:background="@drawable/bg_scope"
            android:gravity="center"
            android:text="Masyarakat"
            android:textSize="12sp"
            android:textColor="@color/primary" />
    </RadioGroup>
    <Space
        android:layout_width="1dp"
        android:layout_height="16dp" />
    <!-- MATERI-02: EditText menerima input; Kotlin membaca text.toString(). -->
    <EditText
        android:id="@+id/etFilter"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_white"
        android:drawableStart="@drawable/ic_figma_search"
        android:drawablePadding="8dp"
        android:paddingHorizontal="16dp"
        android:hint="Cari judul, kategori, atau lokasi"
        android:textSize="12sp"
        android:singleLine="true"
        android:inputType="text" />
    <!-- MATERI-15: singleSelection membatasi maksimal satu pilihan, bukan mewajibkan satu pilihan. -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupFilter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:singleSelection="true">
        <com.google.android.material.chip.Chip
            android:id="@+id/chipSemua"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Semua" />
        <com.google.android.material.chip.Chip
            android:id="@+id/chipDiproses"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Diproses" />
        <com.google.android.material.chip.Chip
            android:id="@+id/chipMenunggu"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Menunggu" />
        <com.google.android.material.chip.Chip
            android:id="@+id/chipSelesai"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Selesai" />
    </com.google.android.material.chip.ChipGroup>
    <Space
        android:layout_width="1dp"
        android:layout_height="12dp" />
    <TextView
        android:id="@+id/tvHeading"
        style="@style/Text.SiComplaint.Heading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Riwayat laporan saya"
        android:textSize="16sp" />
    <Space
        android:layout_width="1dp"
        android:layout_height="8dp" />
    <TextView
        android:id="@+id/tvCount"
        style="@style/Text.SiComplaint.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="6 laporan"
        android:textSize="12sp" />
    <Space
        android:layout_width="1dp"
        android:layout_height="8dp" />
    <TextView
        android:id="@+id/tvEmpty"
        style="@style/Text.SiComplaint.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Belum ada laporan. Ketuk tombol + untuk membuat laporan."
        android:textSize="14sp"
        android:padding="24dp"
        android:gravity="center" />
    <ListView
        android:id="@+id/listPengaduan"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="8dp"
        android:paddingBottom="72dp"
        android:clipToPadding="false" />
</LinearLayout>
