<?xml version="1.0" encoding="utf-8"?>
<!--
PANDUAN SALIN XML KE PROJECT BARU
1. Shape untuk sudut/garis/padding; terapkan sebagai android:background pada view.
2. Salin ke res/drawable; nama file menjadi nama resource.
-->

<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Warna solid untuk latar belakang -->
    <solid android:color="#FFFFFF" />
    <!-- Garis tepi (stroke) -->
    <stroke
        android:width="1dp"
        android:color="#E5E7EB" />
    <!-- Sudut yang membulat -->
    <corners android:radius="12dp" />
    <!-- Padding di dalam container -->
    <padding
        android:left="12dp"
        android:top="12dp"
        android:right="12dp"
        android:bottom="12dp" />
</shape>
