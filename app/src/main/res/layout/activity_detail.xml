<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_app">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarDetail"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/primary"
        app:title="Detail Laporan"
        app:titleTextColor="@color/white"
        app:titleTextAppearance="@style/Text.SiComplaint.Heading"
        app:navigationIcon="@drawable/ic_figma_back"
        app:navigationIconTint="@color/white" />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivDetailImage"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:src="@drawable/lubang"
                        android:scaleType="centerCrop"
                        android:contentDescription="Foto laporan"
                        app:shapeAppearanceOverlay="@style/Shape.SiComplaint" />
                    <Space
                        android:layout_width="1dp"
                        android:layout_height="16dp" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:id="@+id/tvKategori"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Kategori: Infrastruktur"
                            android:textColor="@color/primary"
                            android:fontFamily="@font/inter_medium"
                            android:textSize="12sp" />
                        <TextView
                            android:id="@+id/chipStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/chip_diproses"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:text="Dalam Proses"
                            android:textSize="10sp"
                            android:textColor="@color/white" />
                    </LinearLayout>
                    <Space
                        android:layout_width="1dp"
                        android:layout_height="16dp" />
                    <TextView
                        android:id="@+id/tvReportTitle"
                        style="@style/Text.SiComplaint.Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Judul laporan"
                        android:textSize="20sp" />
                    <Space
                        android:layout_width="1dp"
                        android:layout_height="16dp" />
                    <TextView
                        android:id="@+id/tvLocation"
                        style="@style/Text.SiComplaint.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Lokasi"
                        android:textSize="12sp"
                        android:drawableStart="@drawable/ic_figma_pin"
                        android:drawablePadding="8dp" />
                    <Space
                        android:layout_width="1dp"
                        android:layout_height="8dp" />
                    <TextView
                        android:id="@+id/tvTanggal"
                        style="@style/Text.SiComplaint.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tanggal Lapor"
                        android:textSize="12sp"
                        android:drawableStart="@drawable/ic_figma_calendar"
                        android:drawablePadding="8dp" />
                    <Space
                        android:layout_width="1dp"
                        android:layout_height="16dp" />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/gray_border" />
                    <Space
                        android:layout_width="1dp"
                        android:layout_height="16dp" />
                    <TextView
                        android:id="@+id/tvDeskripsiLabel"
                        style="@style/Text.SiComplaint.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Deskripsi Masalah:"
                        android:textSize="13sp" />
                    <Space
                        android:layout_width="1dp"
                        android:layout_height="8dp" />
                    <TextView
                        android:id="@+id/tvReportDesc"
                        style="@style/Text.SiComplaint.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Deskripsi"
                        android:textSize="14sp"
                        android:lineSpacingExtra="4dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <Space
                android:layout_width="1dp"
                android:layout_height="16dp" />
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:id="@+id/tvPelapor"
                        style="@style/Text.SiComplaint.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Pelapor"
                        android:textSize="13sp" />
                    <Space
                        android:layout_width="1dp"
                        android:layout_height="8dp" />
                    <TextView
                        android:id="@+id/tvVerifikasi"
                        style="@style/Text.SiComplaint.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Status verifikasi"
                        android:textSize="12sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <Space
                android:layout_width="1dp"
                android:layout_height="16dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLacak"
                style="@style/Widget.SiComplaint.Button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Lacak Status" />
            <Space
                android:layout_width="1dp"
                android:layout_height="8dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBackToMain"
                style="@style/Widget.SiComplaint.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Kembali" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
