<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/splashMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/merah_utama">

    <!-- Container Tengah: Logo & Brand Name -->
    <LinearLayout
        android:id="@+id/layoutCenterBrand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/layoutBottomCredit"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="spread_inside"
        android:layout_marginTop="160dp">

        <!-- Logo SiComplaint Versi Putih -->
        <ImageView
            android:id="@+id/ivSplashLogo"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:contentDescription="Logo SiComplaint"
            android:src="@drawable/ic_sicomplaint_white" />

        <!-- Nama Brand -->
        <TextView
            android:id="@+id/tvSplashAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/inter_18pt_bold"
            android:text="SiComplaint"
            android:textColor="@color/white"
            android:textSize="32sp"
            android:letterSpacing="0.02" />

        <!-- Tagline -->
        <TextView
            android:id="@+id/tvSplashTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/inter_24pt_regular"
            android:text="Lapor Cepat, Kota Berubah"
            android:textColor="#FFEAEA"
            android:textSize="15sp" />

        <!-- Progress Indicator -->
        <ProgressBar
            android:id="@+id/progressBarSplash"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="32dp"
            android:indeterminateTint="@color/white" />

    </LinearLayout>

    <!-- Footer Identitas Pengembang -->
    <LinearLayout
        android:id="@+id/layoutBottomCredit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_18pt_bold"
            android:text="Rafli Hanafi - 2455301157"
            android:textColor="@color/white"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/inter_24pt_regular"
            android:text="Mobile Programming 2026 | 3TIA"
            android:textColor="#FFCDD2"
            android:textSize="11sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
