<!--
PANDUAN SALIN XML KE PROJECT BARU
1. Header tambahan ListView: di-inflate BerandaFragment, bukan layout Activity utama.
2. GridLayout berisi enam kategori statis.
3. bg_header_wafe adalah vector di drawable; salin file rujukannya juga.
4. Jika menyalin header lengkap, ikutkan id/resource dan aksi host yang digunakan Kotlin.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:orientation="vertical"
        android:id="@+id/hero"
        android:padding="24dp"
        android:background="@color/primary">
        <TextView
            android:id="@+id/tvWelcomeTitle"
            style="@style/Text.SiComplaint.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Halo, Rafli"
            android:textSize="14sp"
            android:textColor="@color/white" />
        <Space
            android:layout_width="1dp"
            android:layout_height="16dp" />
        <TextView
            android:id="@+id/tvAjakan"
            style="@style/Text.SiComplaint.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ada yang perlu
dilaporkan?"
            android:textSize="24sp"
            android:textColor="@color/white" />
        <Space
            android:layout_width="1dp"
            android:layout_height="16dp" />
        <EditText
            android:id="@+id/etCari"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_white"
            android:drawableStart="@drawable/ic_figma_search"
            android:drawablePadding="8dp"
            android:paddingHorizontal="16dp"
            android:hint="Cari laporan di sekitarmu"
            android:textSize="12sp"
            android:singleLine="true"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:textColor="@color/text_dark"
            android:textColorHint="@color/gray_text" />
        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />
        <TextView
            android:id="@+id/tvRingkasan"
            style="@style/Text.SiComplaint.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="6 laporan masyarakat"
            android:textSize="12sp"
            android:textColor="#FFEAEA" />
    </LinearLayout>
    <View
        android:id="@+id/viewWaveHeader"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:background="@drawable/bg_header_wafe" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
        <TextView
            android:id="@+id/tvKategoriHeading"
            style="@style/Text.SiComplaint.Heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kategori Laporan"
            android:textSize="14sp" />
        <Space
            android:layout_width="1dp"
            android:layout_height="8dp" />
        <!-- MATERI-15 GRIDLAYOUT: 6 kategori statis, 3 kolom; columnWeight membagi lebar ruang kolom. -->
        <androidx.gridlayout.widget.GridLayout
            android:id="@+id/gridMenuKategori"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:columnCount="3"
            app:useDefaultMargins="true">

            <TextView
                style="@style/Text.SiComplaint.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:drawablePadding="6dp"
                android:drawableTop="@drawable/ic_figma_road"
                android:drawableTint="@color/primary"
                android:gravity="center"
                android:padding="8dp"
                android:text="Jalan"
                android:textSize="11sp"
                app:layout_columnWeight="1"
                app:layout_gravity="fill_horizontal" />

            <TextView
                style="@style/Text.SiComplaint.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:drawablePadding="6dp"
                android:drawableTop="@drawable/ic_figma_trash"
                android:drawableTint="@color/primary"
                android:gravity="center"
                android:padding="8dp"
                android:text="Sampah"
                android:textSize="11sp"
                app:layout_columnWeight="1"
                app:layout_gravity="fill_horizontal" />

            <TextView
                style="@style/Text.SiComplaint.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:drawablePadding="6dp"
                android:drawableTop="@drawable/ic_figma_lamp"
                android:drawableTint="@color/primary"
                android:gravity="center"
                android:padding="8dp"
                android:text="Lampu"
                android:textSize="11sp"
                app:layout_columnWeight="1"
                app:layout_gravity="fill_horizontal" />

            <TextView
                style="@style/Text.SiComplaint.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:drawablePadding="6dp"
                android:drawableTop="@drawable/ic_figma_drain"
                android:drawableTint="@color/primary"
                android:gravity="center"
                android:padding="8dp"
                android:text="Drainase"
                android:textSize="11sp"
                app:layout_columnWeight="1"
                app:layout_gravity="fill_horizontal" />

            <TextView
                style="@style/Text.SiComplaint.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:drawablePadding="6dp"
                android:drawableTop="@drawable/ic_figma_facility"
                android:drawableTint="@color/primary"
                android:gravity="center"
                android:padding="8dp"
                android:text="Fasilitas"
                android:textSize="11sp"
                app:layout_columnWeight="1"
                app:layout_gravity="fill_horizontal" />

            <TextView
                style="@style/Text.SiComplaint.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:drawablePadding="6dp"
                android:drawableTop="@drawable/ic_figma_reports"
                android:drawableTint="@color/primary"
                android:gravity="center"
                android:padding="8dp"
                android:text="Ketertiban"
                android:textSize="11sp"
                app:layout_columnWeight="1"
                app:layout_gravity="fill_horizontal" />
        </androidx.gridlayout.widget.GridLayout>
        <Space
            android:layout_width="1dp"
            android:layout_height="8dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDaftarPublik"
            style="@style/Widget.SiComplaint.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Lihat pengaduan masyarakat" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAbout"
            style="@style/Widget.SiComplaint.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="@string/about_app_title"
            app:icon="@drawable/ic_info"
            app:iconTint="@color/primary"
            android:textColor="@color/primary" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPortalWeb"
            style="@style/Widget.SiComplaint.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="Portal SP4N-LAPOR!"
            app:icon="@drawable/ic_web"
            app:iconTint="@color/primary"
            android:textColor="@color/primary" />
        <Space
            android:layout_width="1dp"
            android:layout_height="16dp" />
        <TextView
            android:id="@+id/tvPengaduanTerbaru"
            style="@style/Text.SiComplaint.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pengaduan Terbaru"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
