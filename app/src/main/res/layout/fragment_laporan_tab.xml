<?xml version="1.0" encoding="utf-8"?>
<!--
PANDUAN SALIN XML KE PROJECT BARU | MATERI TAB & RECYCLERVIEW (PERTEMUAN 10)
1. Layout isi setiap Tab di dalam ViewPager2 (sesuai modul Tahap 4.5).
2. Memuat RecyclerView untuk menampilkan data pengaduan masyarakat.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_app"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp">

    <TextView
        android:id="@+id/tvTabHeading"
        style="@style/Text.SiComplaint.Heading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Daftar Pengaduan"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvTabCount"
        style="@style/Text.SiComplaint.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0 laporan"
        android:textSize="11sp"
        android:textColor="@color/primary"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvEmpty"
        style="@style/Text.SiComplaint.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:textSize="14sp"
        android:padding="32dp"
        android:gravity="center"
        android:text="Belum ada pengaduan pada tab ini." />

    <!-- MATERI PERTEMUAN 10: RECYCLERVIEW UNTUK DAFTAR DINAMIS (TAHAP 4.5) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPengaduanTab"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="72dp" />

</LinearLayout>
